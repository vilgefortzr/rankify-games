{
  "info": {
    "name": "RankifyGames API",
    "description": "API колекція для RankifyGames.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Колекції",
      "item": [
        {
          "name": "Отримати список колекцій",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collections/?search=",
              "host": ["{{baseUrl}}"],
              "path": ["collections", ""],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Пошук за назвою чи описом"
                }
              ]
            }
          }
        },
        {
          "name": "Створити колекцію",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Best Assassin's Creed Game\",\n  \"genre\": \"action\",\n  \"description\": \"Колекція для визначення найкращої частини серії Assassin's Creed.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/collections/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", ""]
            }
          }
        },
        {
          "name": "Отримати деталі колекції",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collections/1/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", ""]
            }
          }
        },
        {
          "name": "Часткове оновлення колекції (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Collection Title\",\n  \"genre\": \"rpg\",\n  \"description\": \"Оновлений опис колекції.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/collections/1/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", ""]
            }
          }
        },
        {
          "name": "Видалити колекцію",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collections/1/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Ігри в колекції",
      "item": [
        {
          "name": "Додати гру в колекцію",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"steam_id\": 292030\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/collections/1/games/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", "games", ""]
            }
          }
        },
        {
          "name": "Видалити гру з колекції",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collections/1/games/292030/",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", "games", "292030", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Голосування",
      "item": [
        {
          "name": "Проголосувати за гру в колекції",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection_game\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/collections/1/votes/1",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", "votes", "1"]
            }
          }
        },
        {
          "name": "Видалити голос за гру",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/collections/1/votes/1",
              "host": ["{{baseUrl}}"],
              "path": ["collections", "1", "votes", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Ігри та Steam",
      "item": [
        {
          "name": "Отримати список ігор (база)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/?search=",
              "host": ["{{baseUrl}}"],
              "path": ["games", ""],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Пошук по локальній базі"
                }
              ]
            }
          }
        },
        {
          "name": "Отримати деталі гри за steam_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/292030/",
              "host": ["{{baseUrl}}"],
              "path": ["games", "292030", ""]
            }
          }
        },
        {
          "name": "Пошук ігор у Steam API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/steam/games/?search=Witcher",
              "host": ["{{baseUrl}}"],
              "path": ["steam", "games", ""],
              "query": [
                {
                  "key": "search",
                  "value": "Witcher",
                  "description": "Пошуковий запит до Steam API"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}