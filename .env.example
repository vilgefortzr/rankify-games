# Copy this file to .env and fill in the values: cp .env.example .env

# Django secret key. Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True for local development, False in production
DEBUG=True

# Comma-separated hosts the server answers to
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# SQLite database file name (relative to the project root)
DATABASE_NAME=db.sqlite3

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=5
REFRESH_TOKEN_LIFETIME_DAYS=1

# Log level for the project code: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
